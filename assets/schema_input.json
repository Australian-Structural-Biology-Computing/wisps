{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/Australian-Structural-Biology-Computing/wisps/master/assets/schema_input.json",
    "title": "Australian-Structural-Biology-Computing/wisps pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "id": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Sequence name must be provided and cannot contain spaces",
                "meta": ["id"]
            },
            "sequence": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.(fa(sta)?|yaml|yml|json)$",
                "errorMessage": "Fasta, yaml or json file must be provided, cannot contain spaces and must have extension '.fa', '.fasta', '.yaml', '.yml', or '.json'"
            },
            "type": {
                "type": "string",
                "pattern": "^\\S+$",
                "meta": ["type"],
                "default": "protein"
            },
            "group": {
                "type": "string",
                "pattern": "^\\S+$",
                "meta": ["group"],
                "default": "all"
            }
        },
        "required": ["id", "sequence"]
    }
}
